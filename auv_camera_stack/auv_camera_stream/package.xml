<?xml version="1.0"?>
<package format="3">
  <n>auv_camera_stream</n>
  <version>1.0.0</version>
  <description>
    Jetson-side GStreamer H264/NVENC streaming node for AUV/ROV camera.
    Uses nvv4l2h264enc (hardware) — NOT vp8enc/x264enc (software).
  </description>
  <maintainer email="you@email.com">AUV Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>auv_camera_msgs</depend>

  <!-- GStreamer: installed via apt on Jetson, not rosdep managed -->
  <!-- sudo apt install libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
